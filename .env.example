# ---------------------------------------------------------------------------
# Whiskey Mistress — environment
#
# The site runs with ZERO configuration: without Supabase credentials it serves
# the built-in seed catalogue (src/lib/seed.ts) in read-only "preview" mode.
# Fill these in to switch the whole site — and the /admin dashboard — onto a
# live Supabase project.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser. Used for admin writes + storage.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site URL (SEO metadata, Open Graph, sitemap, structured data).
# Optional on Vercel: the production domain is detected automatically. Set this
# once a custom domain is live, so canonical URLs point there rather than at
# the *.vercel.app address.
NEXT_PUBLIC_SITE_URL=

# Optional: looping hero background video (mp4/webm). Falls back to a
# cinematic parallax image stack when unset.
NEXT_PUBLIC_HERO_VIDEO_URL=

# Optional: Google Maps embed. Without a key the site renders the free
# keyless embed, which works but shows a "for development" watermark.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# Optional: analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=
